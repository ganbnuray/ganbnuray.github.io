---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';

interface Props {
  // path inside photos/, e.g. "hero/1".
  path: string;
  caption?: string;
  // output width in pixels.
  width?: number;
  // prefix the caption with #.
  comment?: boolean;
}
const { path, caption = '', width = 520, comment = true } = Astro.props;
const img = photo(path);
// path shown in an empty slot; adds .jpg only when there is no extension.
const hint = /\.[a-z0-9]+$/i.test(path) ? path : `${path}.jpg`;
---
<figure class="shot">
  {img
    ? <Image src={img} alt={caption} width={width} class="slot" />
    : <div class="slot empty" aria-hidden="true"><span>photos/{hint}</span></div>}
  {caption && <figcaption>{comment ? '# ' : ''}{caption}</figcaption>}
</figure>
